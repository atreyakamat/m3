# M3 Malaria Surveillance Platform - Dedicated Staging Environment Template
NODE_ENV=staging
SEED_ON_START=true

# ---- Staging PostgreSQL Database ----
POSTGRES_DB=m3_staging
POSTGRES_USER=m3_staging
POSTGRES_PASSWORD=staging-secure-pass-m3-2026!
POSTGRES_PORT=5545
DATABASE_URL=postgresql://m3_staging:staging-secure-pass-m3-2026!@localhost:5545/m3_staging?schema=public

# ---- Staging API Service ----
PORT=8013
JWT_SECRET=staging-jwt-secret-m3-surveillance-2026-auth-token-key-32chars
JWT_EXPIRES_IN=8h
BOOTSTRAP_SECRET=staging-bootstrap-secret-m3-auth-2026
API_CORS_ORIGINS=*

# ---- Staging Frontends & Mobile Endpoints ----
WEB_PORT=5183
STAGING_HOST_IP=192.168.1.120
VITE_API_BASE_URL=http://192.168.1.120:8013/api/v1
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.120:8013/api/v1
