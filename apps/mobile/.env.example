# Mobile app configuration. Copy to apps/mobile/.env and set your values.
# EXPO_PUBLIC_* variables are read by the app at bundle time.

# Backend base URL the phone will call.
# - Android emulator on the same machine:  http://10.0.2.2:8003/api/v1
# - Physical phone on the same Wi-Fi:       http://<HOST_LAN_IP>:8003/api/v1
#   (find <HOST_LAN_IP> on the backend machine; it is NOT "localhost")
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8003/api/v1
