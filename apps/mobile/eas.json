{
  "cli": {
    "version": ">= 14.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://192.168.1.116:8003/api/v1"
      },
      "_docs": "Task 2: single arm64-v8a ABI + shrinkable release build keeps the APK under 25 MB. The dedicated Gradle task skips the other three architectures; ProGuard/R8 stays enabled via android/app/build.gradle (enableProguardInReleaseBuilds).",
      "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://192.168.1.116:8003/api/v1"
      },
      "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
    }
  },
  "submit": {
    "production": {}
  }
}
