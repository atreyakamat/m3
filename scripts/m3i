#!/usr/bin/env bash
# ==============================================================================
# M3 Malaria Surveillance Platform — Log Inspector & Streamer (m3i)
# Streams or inspects logs for:
#   1. Backend API (services/api)
#   2. Web Console (apps/web)
#   3. Mobile App (apps/mobile Expo)
# ==============================================================================

# Detect repository root
if [ -n "$M3_DIR" ] && [ -f "$M3_DIR/services/api/app/main.py" ]; then
    M3_ROOT="$M3_DIR"
elif [ -f "./services/api/app/main.py" ] && [ -d "./apps/web" ]; then
    M3_ROOT="$(pwd)"
elif [ -f "$(git rev-parse --show-toplevel 2>/dev/null)/services/api/app/main.py" ]; then
    M3_ROOT="$(git rev-parse --show-toplevel)"
elif [ -f "/home/atreya/Projects/m3/services/api/app/main.py" ]; then
    M3_ROOT="/home/atreya/Projects/m3"
else
    echo "Error: Could not locate M3 repository root." >&2
    exit 1
fi

LOG_DIR="${M3_ROOT}/.m3/logs"
API_LOG="${LOG_DIR}/api.log"
WEB_LOG="${LOG_DIR}/web.log"
MOBILE_LOG="${LOG_DIR}/mobile.log"

mkdir -p "$LOG_DIR"
touch "$API_LOG" "$WEB_LOG" "$MOBILE_LOG"

BOLD="\033[1m"
GREEN="\033[32m"
CYAN="\033[36m"
YELLOW="\033[33m"
RESET="\033[0m"

# Handle specific service logs
case "${1}" in
    api)
        echo -e "${BOLD}${CYAN}=== Streaming Backend API Logs (.m3/logs/api.log) ===${RESET}"
        tail -n 50 -f "$API_LOG"
        exit 0
        ;;
    web)
        echo -e "${BOLD}${GREEN}=== Streaming Web Console Logs (.m3/logs/web.log) ===${RESET}"
        tail -n 50 -f "$WEB_LOG"
        exit 0
        ;;
    mobile|expo)
        echo -e "${BOLD}${YELLOW}=== Streaming Mobile Expo Logs (.m3/logs/mobile.log) ===${RESET}"
        tail -n 50 -f "$MOBILE_LOG"
        exit 0
        ;;
    status)
        "${M3_ROOT}/scripts/m3s" status
        exit 0
        ;;
    -n)
        lines="${2:-30}"
        echo -e "\n${BOLD}${CYAN}--- [API] Recent ${lines} lines ---${RESET}"
        tail -n "$lines" "$API_LOG"
        echo -e "\n${BOLD}${GREEN}--- [WEB] Recent ${lines} lines ---${RESET}"
        tail -n "$lines" "$WEB_LOG"
        echo -e "\n${BOLD}${YELLOW}--- [MOBILE] Recent ${lines} lines ---${RESET}"
        tail -n "$lines" "$MOBILE_LOG"
        exit 0
        ;;
    -h|--help|help)
        echo -e "${BOLD}M3 Log Inspector (m3i)${RESET}"
        echo "Usage:"
        echo "  m3i              Stream all service logs simultaneously with color tags"
        echo "  m3i api          Stream only Backend API logs"
        echo "  m3i web          Stream only Web Console logs"
        echo "  m3i mobile       Stream only Mobile Expo logs"
        echo "  m3i status       Show service health and port status"
        echo "  m3i -n <num>     Show last <num> lines of all logs and exit"
        exit 0
        ;;
esac

# Default: Stream all logs concurrently with Python
python3 - <<EOF "$API_LOG" "$WEB_LOG" "$MOBILE_LOG"
import sys, time, threading, os

api_log, web_log, mobile_log = sys.argv[1], sys.argv[2], sys.argv[3]

SERVICES = [
    ("API",    api_log,    "\033[1;36m"), # Bold Cyan
    ("WEB",    web_log,    "\033[1;32m"), # Bold Green
    ("MOBILE", mobile_log, "\033[1;33m"), # Bold Yellow
]

RESET = "\033[0m"
DIM   = "\033[2m"

print(f"\033[1mStreaming M3 service logs... Press Ctrl+C to exit.\033[0m")
print(f"Tags: \033[1;36m[API]\033[0m Backend API (8001) | \033[1;32m[WEB]\033[0m Web Console (5173) | \033[1;33m[MOBILE]\033[0m Expo (8081)")
print("=" * 70)

stop_event = threading.Event()

def tail_file(tag, filepath, color):
    try:
        with open(filepath, "r", encoding="utf-8", errors="replace") as f:
            # Print initial recent lines (up to last 15 lines)
            lines = f.readlines()
            for line in lines[-12:]:
                line_str = line.rstrip()
                if line_str:
                    print(f"{color}[{tag:^6}]{RESET} {line_str}")
            f.seek(0, os.SEEK_END)
            
            while not stop_event.is_set():
                line = f.readline()
                if line:
                    line_str = line.rstrip()
                    if line_str:
                        print(f"{color}[{tag:^6}]{RESET} {line_str}")
                else:
                    time.sleep(0.1)
    except Exception as e:
        if not stop_event.is_set():
            print(f"{color}[{tag:^6}]{RESET} {DIM}(Waiting for log file to initialize...){RESET}")

threads = []
for tag, path, col in SERVICES:
    t = threading.Thread(target=tail_file, args=(tag, path, col), daemon=True)
    t.start()
    threads.append(t)

try:
    while True:
        time.sleep(0.5)
except KeyboardInterrupt:
    stop_event.set()
    print(f"\n\033[32m✓ Detached from log stream (services continue running in background).\033[0m")
EOF
