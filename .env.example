# Database mode (REQUIRED): postgres | sqlite | none. The server refuses to
# start without an explicit mode — there is no implicit default database.
#   postgres — connect ONLY to DATABASE_URL below (must be a PostgreSQL URL).
#              Startup verifies connectivity and refuses to start on failure;
#              it never falls back to SQLite.
#   sqlite   — connect ONLY to DATABASE_URL (must be sqlite://, e.g. a
#              disposable testing file such as sqlite:////tmp/test_m3.db).
#              Never point this at a shared/production database.
#   none     — validation-only: no engine, no connection, no migrations, no
#              table creation, no seed. DATABASE_URL is ignored entirely and
#              database-dependent endpoints return 503 database_disabled.
# Precedence: real environment variables > values in this file; the mode never
# changes the URL that DATABASE_URL already selected.
M3_DATABASE_MODE=postgres

# Copy to .env. Values below are placeholders; generate unique secrets before starting.
POSTGRES_DB=m3
POSTGRES_USER=m3_app
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://m3_app:CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD@db:5432/m3
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET_AT_LEAST_32_CHARACTERS
BOOTSTRAP_SECRET=CHANGE_ME_ONE_TIME_BOOTSTRAP_SECRET
API_CORS_ORIGINS=http://localhost:5173,http://OFFICE_LAN_IP:5173
API_BASE_URL=http://OFFICE_LAN_IP:8000/api/v1
VITE_API_BASE_URL=http://OFFICE_LAN_IP:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://OFFICE_LAN_IP:8000/api/v1
