# ---- PostgreSQL (backend) ----
POSTGRES_DB=m3
POSTGRES_USER=m3
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_PORT=5544

# Prisma connection string.
# Host-run (migrations/tests): host = localhost:${POSTGRES_PORT}
# In docker-compose the api service overrides host to "db".
DATABASE_URL=postgresql://m3:change-me-in-prod@localhost:5544/m3?schema=public

# ---- API ----
PORT=8003
JWT_SECRET=dev-jwt-secret-change-me-32+chars-long
JWT_EXPIRES_IN=12h
BOOTSTRAP_SECRET=dev-bootstrap-secret-change-me
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# ---- Frontends ----
# Web (Vite) and mobile (Expo) read the API base URL at build/runtime.
VITE_API_BASE_URL=http://localhost:8003/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8003/api/v1
